];

// Live demo gallery. Featured tile leads; the rest are a secondary row.
// The CPA Firm KPI board is listed last as the accounting deep-dive.
const dashboards = [
  {
    featured: true,
    tag: 'Cashflow',
    title: '13-Week Cashflow Forecast',
    blurb:
      'Actuals, then a projection with a variance band, tracked against the reserve floor a tight week nearly breaches.',
    href: '/dashboards/cashflow-forecast/',
    motif: 'line',
    series: [48, 49, 53, 59, 52, 52, 42, 58, 48, 29, 33, 39, 30],
