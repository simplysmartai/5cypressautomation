import DashboardShowcase from '../components/DashboardShowcase.astro';
import { getService } from '../data/services';

const workflowCards = [
  {
    tag: '01 / Dashboard',
    slug: 'practice-kpi-dashboard',
    title: 'Firm KPI dashboard',
    description:
      'Realization, WIP, AR aging, and billing pulled live from QBO and your practice system into one panel every partner can read. No month-end wait.',
    highlight: true,
  },
  {
    tag: '02 / BI',
    slug: 'business-intelligence-dashboard',
    title: 'Business intelligence dashboard',
    description:
      'A proper data model with automated refresh and role-based views, built the way an enterprise BI team would, but scoped and priced for a small business.',
