const coreWorkflows = workflowCards.map((card) => {
  const service = getService(card.slug);
  return {
    ...card,
    href: `/services/${card.slug}/`,
    timeline: service?.timeline,
    price: service?.setupPrice,
    monthlyPrice: service?.monthlyPrice,
