});

const trustSignals = [
  {
    title: 'Scope before build',
    text: 'You get a metric list, data sources, a model sketch, and refresh cadence before the build starts.',
  },
  {
    title: 'Modeled, not glued',
    text: 'Numbers come from a real data model with defined logic, not a pile of linked spreadsheets that break.',
  },
  {
    title: 'Read-only by default',
    text: 'We connect through narrowly scoped, read-only API access. Never broader than the dashboard needs.',
  },
  {
    title: 'Every metric documented',
    text: 'Each dashboard ships with a plain-English note on how each number is defined and where it comes from.',
