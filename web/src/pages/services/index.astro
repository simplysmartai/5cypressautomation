---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import JsonLd from '../../components/JsonLd.astro';
import { services } from '../../data/services';

const workflowSystems = [
  {
    num: '01',
    label: 'Dashboards',
    title: 'Practice KPI dashboard',
    description:
      'Realization, WIP, AR aging, and billing pulled live from QBO and your practice system into one panel every partner reads — no month-end wait, no exports.',
    examples: ['Realization', 'WIP', 'AR aging', 'Per-partner drill-down'],
    related: ['practice-kpi-dashboard'],
  },
  {
    num: '02',
    label: 'Business intelligence',
    title: 'Business intelligence dashboard',
    description:
      'A proper data model with automated refresh, role-based views, and drill-downs that work — built the way an enterprise BI team would, scoped for a small business.',
    examples: ['Data model', 'Automated refresh', 'Role-based views', 'Source of truth'],
    related: ['business-intelligence-dashboard'],
  },
  {
    num: '03',
    label: 'Forecasting',
    title: 'Cashflow forecasting',
    description:
      'A rolling 13-week forecast refreshed from live actuals and aging, with early alerts before a balance trends negative or a covenant is at risk.',
    examples: ['13-week forecast', 'Low-balance alerts', 'Covenant watch', 'Refreshed daily'],
    related: ['cashflow-forecast-agent'],
  },
  {
    num: '04',
    label: 'Reporting',
    title: 'Monthly reporting package',
    description:
      'The recurring P&L trend, margins, and variances generated and delivered after each close, branded per client. You review the numbers instead of rebuilding them.',
    examples: ['P&L trend', 'Margins', 'Variances', 'Branded delivery'],
    related: ['monthly-client-snapshot'],
  },
  {
    num: '05',
    label: 'Data automation',
    title: 'Spreadsheet & data automation',
    description:
      'The half-day recurring spreadsheet — commission runs, KPI rollups, reconciliations — rebuilt as a one-click or scheduled job, documented and handed off.',
    examples: ['Power Query', 'Scheduled runs', 'KPI rollups', 'No consultant lock-in'],
    related: ['excel-spreadsheet-automation'],
  },
];

const serviceMap = Object.fromEntries(services.map((service) => [service.slug, service]));

// Analyst services lead the site. Operational-automation services keep their URLs
// (SEO) but are demoted to a single discreet link at the bottom of the page.
const analystSlugs = [
  'practice-kpi-dashboard',
  'business-intelligence-dashboard',
  'cashflow-forecast-agent',
  'monthly-client-snapshot',
  'excel-spreadsheet-automation',
];
const automationSlugs = [
  'missed-lead-text-back',
  'document-intake-ai-sort',
  'engagement-onboarding-flow',
  'ar-collections-agent',
  'month-end-close-accelerator',
];
const analystServices = analystSlugs.map((s) => serviceMap[s]).filter(Boolean);
const automationServices = automationSlugs.map((s) => serviceMap[s]).filter(Boolean);
---

<Layout
  title="Fractional Data Analyst Services | 5 Cypress"
  description="The analytics 5 Cypress builds for accounting firms and small businesses: practice KPI dashboards, business intelligence, cashflow forecasting, monthly reporting, and spreadsheet automation."
>
  <Fragment slot="head">
    <JsonLd schema={{
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: '5 Cypress Workflow Systems',
      itemListElement: workflowSystems.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: s.title,
        url: `https://www.5cypress.com/services/#workflow-${s.num}`,
      })),
    }} />
  </Fragment>

  <section class="services-hero section">
    <div class="container services-hero-grid">
      <div class="services-hero-copy reveal">
        <p class="lead-in">Services</p>
        <h1>The analytics your business runs on, finally built right.</h1>
        <p class="services-hero-sub">
          Start with the decision you keep making late or the report that keeps eating a day:
          a KPI dashboard, a business intelligence model, a cashflow forecast, or a monthly
          reporting pack. Built from the data you already have, kept current on a schedule.
        </p>
        <div class="services-actions">
          <Button variant="primary" size="lg" magnetic ripple data-open-booking>
            Book a fit call
          </Button>
          <Button variant="secondary" size="lg" href="#service-library">
            View example builds
          </Button>
        </div>
      </div>

      <div class="services-proof reveal">
        <div class="proof-row">
          <span>10-14</span>
          <p>business days to a first live dashboard</p>
        </div>
        <div class="proof-row">
          <span>3-4</span>
          <p>weeks for a full BI model or forecast engine</p>
        </div>
        <div class="proof-row">
          <span>0</span>
          <p>new logins your team has to learn</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section systems-section">
    <div class="container">
      <div class="section-header reveal">
        <p class="lead-in">What we build</p>
        <h2>Five ways to turn idle data into decisions.</h2>
        <p class="section-sub">
          Each one starts from data you already have and is scoped to your metrics, tools,
          and how fast you actually need the numbers. Pick the one that unblocks a decision.
        </p>
      </div>

      <div class="systems-list">
        {workflowSystems.map((system) => (
          <article class="system-row reveal" id={`workflow-${system.num}`}>
            <div class="system-num">{system.num}</div>
            <div class="system-main">
              <p class="system-label">{system.label}</p>
              <h3>{system.title}</h3>
              <p>{system.description}</p>
              <div class="example-pills">
                {system.examples.map((example) => (
                  <span>{example}</span>
                ))}
              </div>
            </div>
            <div class="system-related">
              <p class="related-label">Example builds</p>
              {system.related.map((slug) => {
                const related = serviceMap[slug];
                return related && (
                  <a href={`/services/${related.slug}/`} class="related-link">
                    <span>{related.shortTitle}</span>
                    <small>{related.timeline}</small>
                  </a>
                );
              })}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section specialty-section">
    <div class="container specialty-grid">
      <div class="specialty-copy reveal">
        <p class="lead-in">Specialty lane</p>
        <h2>Accounting and finance is the specialty for a reason.</h2>
        <p>
          Those teams live on dense, high-stakes numbers: realization, WIP, AR aging, cashflow,
          and partner dashboards. That makes the niche a strong proof point — but the same
          analysis travels to any business with real data and no one to model it.
        </p>
      </div>
      <div class="specialty-card reveal">
        <span>Useful for</span>
        <ul>
          <li>CPA and bookkeeping firms (and their clients)</li>
          <li>Fractional CFO practices</li>
          <li>Service businesses flying blind on pipeline</li>
          <li>Medical and professional offices</li>
          <li>Any team rebuilding the same report every week</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="service-library">
    <div class="container">
      <div class="section-header reveal">
        <p class="lead-in">Service library</p>
        <h2>Concrete starting points, with real price ranges.</h2>
        <p class="section-sub">
          Accounting-focused today because those numbers are dense and make useful proof
          points — the same builds adapt to any business with data sitting idle.
        </p>
      </div>

      <div class="library-grid reveal-stagger">
        {analystServices.map((service) => (
          <a class="library-card" href={`/services/${service.slug}/`}>
            <div>
              <p class="library-tag">{service.tag}</p>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>
            <div class="library-meta">
              <span>{service.setupPrice}</span>
              {service.monthlyPrice && <small class="library-monthly">{service.monthlyPrice}</small>}
              <small>{service.timeline}</small>
            </div>
          </a>
        ))}
      </div>

      <p class="automation-note reveal">
        Also handle the back-office plumbing — missed-lead text-back, document intake,
        client onboarding, AR chase, and month-end close?
        {automationServices.map((service, i) => (
          <>
            {i === 0 ? ' ' : ', '}
            <a href={`/services/${service.slug}/`}>{service.shortTitle}</a>
          </>
        ))}. Available on request; the analytics above are the core practice.
      </p>
    </div>
  </section>

  <section class="section founding-band-section">
    <div class="container">
      <div class="founding-band reveal">
        <div>
          <p class="lead-in">Founding five</p>
          <h2>First 5 firms: a flagship dashboard build at $1,500 flat.</h2>
          <p>
            A BI dashboard or cashflow forecast build lists at $2,000–$3,500. Founding clients
            trade a public build walkthrough (numbers anonymized, you approve before publish)
            for the founding rate. We're new — we'd rather earn proof than invent it.
          </p>
        </div>
        <div class="founding-band-action">
          <span class="founding-band-slots">Founding rate — limited</span>
          <Button variant="primary" size="lg" magnetic ripple data-open-booking>
            Book a fit call
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section services-bottom-cta">
    <div class="container">
      <div class="bottom-cta-inner reveal">
        <p class="lead-in">Not sure which one fits?</p>
        <h2>Bring the number you can never see in time.</h2>
        <p>
          One fit call is enough to identify the decision worth unblocking, what data it
          needs, and which dashboard or forecast to build first.
        </p>
        <Button variant="primary" size="lg" magnetic ripple data-open-booking>
          Book a fit call
        </Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .services-hero {
    padding-block: var(--space-24) var(--space-16);
  }
  .services-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: var(--space-16);
    align-items: center;
  }
  .services-hero-copy {
    max-width: 760px;
  }
  .services-hero h1 {
    max-width: 12ch;
  }
  .services-hero-sub {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-top: var(--space-5);
    max-width: 58ch;
  }
  .services-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }
  .services-proof {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(180deg, rgba(93,140,93,0.08), transparent),
      var(--bg-surface);
  }
  .proof-row {
    display: grid;
    grid-template-columns: 82px 1fr;
    gap: var(--space-4);
    align-items: center;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .proof-row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
  .proof-row span {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--brand-accent);
  }
  .proof-row p {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
  .section-header {
    max-width: 720px;
    margin-bottom: var(--space-12);
  }
  .section-sub {
    color: var(--text-secondary);
    margin-top: var(--space-4);
  }
  .systems-section,
  .founding-band {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) auto;
    gap: var(--space-10);
    align-items: center;
    padding: var(--space-10);
    border: 1px solid rgba(251,191,36,0.22);
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(circle at 100% 0%, rgba(251,191,36,0.1), transparent 42%),
      var(--bg-surface);
  }
  .founding-band h2 {
    margin-block: var(--space-3) var(--space-4);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    max-width: 24ch;
  }
  .founding-band p {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
  }
  .founding-band-action {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: stretch;
  }
  .founding-band-slots {
    text-align: center;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: rgba(10,10,12,0.6);
    color: var(--brand-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .founding-band { grid-template-columns: 1fr; padding: var(--space-6); }
  }

  .services-bottom-cta {
    background: var(--bg-surface);
    border-block: 1px solid var(--border-subtle);
  }
  .systems-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-subtle);
  }
  .system-row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) 320px;
    gap: var(--space-8);
    padding: var(--space-10) 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .system-num {
    font-family: var(--font-mono);
    color: var(--brand-accent);
    letter-spacing: var(--tracking-widest);
    font-size: var(--text-xs);
  }
  .system-label,
  .related-label,
  .library-tag,
  .specialty-card span {
    font-family: var(--font-mono);
    color: var(--brand-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }
  .system-main h3 {
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
    font-size: var(--text-2xl);
  }
  .system-main p {
    color: var(--text-secondary);
    max-width: 64ch;
  }
  .example-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .example-pills span {
    padding: 5px 10px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: var(--bg-main);
    color: var(--text-tertiary);
    font-size: var(--text-xs);
  }
  .system-related {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .related-link {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-main);
  }
  .related-link span {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .related-link small {
    color: var(--text-disabled);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-align: right;
  }
  .specialty-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.55fr);
    gap: var(--space-16);
    align-items: start;
  }
  .specialty-copy p {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    margin-top: var(--space-5);
  }
  .specialty-card {
    padding: var(--space-8);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
  }
  .specialty-card ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .specialty-card li {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .library-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }
  .library-card {
    display: flex;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    transition:
      border-color var(--duration-fast),
      transform var(--duration-fast),
      box-shadow var(--duration-fast);
  }
  .library-card:hover {
    border-color: var(--border-brand);
    transform: translateY(-3px);
    box-shadow: var(--shadow-glow);
  }
  .library-card h3 {
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--text-xl);
  }
  .library-card p {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .library-meta {
    min-width: 130px;
    text-align: right;
  }
  .library-meta span {
    display: block;
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-weight: var(--weight-bold);
  }
  .library-meta small {
    color: var(--text-disabled);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }
  .bottom-cta-inner {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .bottom-cta-inner p {
    color: var(--text-secondary);
    font-size: var(--text-base);
  }
  .automation-note {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    color: var(--text-disabled);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    max-width: 70ch;
  }
  .automation-note a {
    color: var(--text-tertiary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .automation-note a:hover { color: var(--text-secondary); }
  @media (max-width: 1024px) {
    .services-hero-grid,
    .system-row,
    .specialty-grid {
      grid-template-columns: 1fr;
    }
    .services-proof,
    .system-related {
      max-width: 560px;
    }
    .library-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .services-hero h1 {
      max-width: none;
    }
    .library-card {
      flex-direction: column;
    }
    .library-meta {
      text-align: left;
    }
  }
</style>
