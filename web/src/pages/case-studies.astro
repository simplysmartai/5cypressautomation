---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import JsonLd from '../components/JsonLd.astro';

const examples = [
  {
    id: 'practice-kpi',
    title: 'Practice KPI Dashboard',
    segment: 'Realization, WIP, AR aging, and billing for a 4-partner CPA firm',
    tag: 'Practice KPI',
    problem: 'Partners were flying blind until month-end. Realization, WIP, and AR aging lived in separate spreadsheets, each updated by a different person, and rarely agreed.',
    workflow: 'A live dashboard models the practice from QBO and practice-management data — realization, WIP balance, AR aging buckets, and monthly billings, with per-partner drill-down. One shared URL, always current.',
    href: '/demo/',
    cta: 'Open Dashboard',
    results: [
      { stat: '4 partners', label: 'each with a drill-down view' },
      { stat: '5 KPIs', label: 'realization, WIP, AR, billings, collections' },
      { stat: '1 URL', label: 'shared, always current' },
      { stat: '0 exports', label: 'no month-end spreadsheet scramble' },
    ],
  },
  {
    id: 'cashflow-forecast',
    title: '13-Week Cashflow Forecast',
    segment: 'Actuals, projection, variance band, and reserve floor',
    tag: 'Forecast',
    problem: 'Cashflow models built in Excel went stale within a week, so the forecast only surfaced during a crisis — too late to act on.',
    workflow: 'A rolling 13-week forecast pulls live actuals and aging, projects the balance with a best/worst variance band, and flags the week a tight balance nearly breaches the reserve floor.',
    href: '/dashboards/cashflow-forecast/',
    cta: 'Open Dashboard',
    results: [
      { stat: '13 weeks', label: 'rolling forward projection' },
      { stat: '$29K', label: 'projected low the model surfaces early' },
      { stat: '1 band', label: 'best and worst case around the line' },
      { stat: '0 stale', label: 'refreshed from live data, not memory' },
    ],
  },
  {
    id: 'growth-command-center',
    title: 'B2B Growth Command Center',
    segment: 'Revenue, pipeline, marketing, AR, and account health',
    tag: 'BI Dashboard',
    problem: 'Past dashboard work contained sensitive company data, so the public site needed a portfolio-safe way to show real analytics judgment without exposing anything private.',
    workflow: 'A synthetic B2B operating dataset powers an executive dashboard: revenue trend, weighted pipeline, channel ROI, invoice aging, and renewal risk in one modeled view.',
    href: '/dashboards/b2b-growth-command-center/',
    cta: 'Open Dashboard',
    results: [
      { stat: '18 mo', label: 'synthetic operating history modeled' },
      { stat: '6 views', label: 'revenue, sales, marketing, AR, ops, accounts' },
      { stat: '0 client', label: 'records or confidential screenshots used' },
      { stat: '1 URL', label: 'site-ready interactive portfolio asset' },
    ],
  },
  {
    id: 'monthly-reporting',
    title: 'Monthly Reporting Package',
    segment: 'P&L trend, margins, and variances, per client',
    tag: 'Reporting',
    problem: 'The same monthly report was rebuilt by hand from exports every close — hours of formatting, and the numbers shifted depending on who built it.',
    workflow: 'After each close, the package pulls the same source data, shows the P&L trend, margins, and variances, and delivers a branded snapshot. You review the numbers instead of rebuilding them.',
    href: '/dashboards/monthly-reporting-package/',
    cta: 'Open Dashboard',
    results: [
      { stat: 'After close', label: 'generated on schedule, every month' },
      { stat: '1 snapshot', label: 'branded, per client' },
      { stat: '0 exports', label: 'no manual spreadsheet rebuild' },
      { stat: 'Review', label: 'you approve, you do not rebuild' },
    ],
  },
];
---

<Layout
  title="Dashboard Build Walkthroughs | 5 Cypress"
  description="Real dashboard build walkthroughs on synthetic data: practice KPI, cashflow forecast, business intelligence, and monthly reporting — each one live and clickable."
>
  <Fragment slot="head">
    <JsonLd schema={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: '5 Cypress Dashboard Build Walkthroughs',
      description: 'Live dashboard build walkthroughs on clearly-labeled synthetic data: practice KPI, cashflow forecast, business intelligence, and monthly reporting.',
      url: 'https://www.5cypress.com/case-studies',
    }} />
  </Fragment>

  <section class="examples-hero section">
    <div class="container">
      <div class="examples-hero-inner reveal">
        <p class="lead-in">Build Walkthroughs</p>
        <h1>Real dashboards on synthetic data — not case studies we can't back up.</h1>
        <p class="examples-hero-sub">
          Every walkthrough below is a live, clickable dashboard: what the numbers looked
          like before, what we modeled, and what leadership gets back. Real client stories
          get added here — with permission — as the practice grows.
        </p>
      </div>
    </div>
  </section>

  <section class="section examples-section">
    <div class="container">
      <div class="examples-list">
        {examples.map((example, index) => (
          <article class="example-card reveal" id={example.id}>
            <div class="example-index">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{example.tag}</p>
            </div>

            <div class="example-main">
              <p class="example-segment">{example.segment}</p>
              <h2>{example.title}</h2>

              <div class="example-columns">
                <div>
                  <h3>Before</h3>
                  <p>{example.problem}</p>
                </div>
                <div>
                  <h3>What we built</h3>
                  <p>{example.workflow}</p>
                </div>
              </div>

              <div class="results-grid">
                {example.results.map((result) => (
                  <div class="result-card">
                    <strong>{result.stat}</strong>
                    <span>{result.label}</span>
                  </div>
                ))}
              </div>

              {example.href && (
                <div class="example-action">
                  <Button href={example.href} variant="secondary">{example.cta}</Button>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section note-section">
    <div class="container">
      <div class="note-panel reveal">
        <p class="lead-in">About These Walkthroughs</p>
        <h2>Synthetic data now. Real client proof as the practice grows.</h2>
        <p>
          These are build walkthroughs on clearly-labeled synthetic data, not public
          client case studies. They give you a concrete, clickable view of the dashboards
          5 Cypress builds — without borrowing logos or inventing proof we can't stand behind.
        </p>
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container">
      <div class="cta-panel reveal">
        <div>
          <p class="lead-in">Your Numbers</p>
          <h2>Have a version of one of these buried in your business?</h2>
        </div>
        <div class="cta-actions">
          <Button variant="primary" size="lg" magnetic ripple data-open-booking>
            Book a fit call
          </Button>
          <Button variant="secondary" size="lg" href="/services/">
            View Services
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .examples-hero {
    padding: calc(var(--space-24) + 3rem) 0 var(--space-24);
    background:
      linear-gradient(135deg, rgba(42, 71, 54, 0.09), transparent 48%),
      linear-gradient(180deg, var(--bg-main), var(--bg-surface));
  }

  .examples-hero-inner {
    max-width: 920px;
  }

  .examples-hero h1 {
    margin: 0 0 var(--space-6);
    color: var(--text-primary);
    font-size: clamp(2.75rem, 5.2vw, 4.5rem);
    line-height: 0.94;
    letter-spacing: 0;
  }

  .examples-hero-sub {
    max-width: 760px;
    color: var(--text-secondary);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.7;
  }

  .examples-list {
    display: grid;
    gap: var(--space-6);
  }

  .example-card {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-8);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    padding: var(--space-8);
  }

  .example-index span {
    display: block;
    color: var(--brand-accent);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .example-index p,
  .example-segment {
    margin: 0;
    color: var(--brand-primary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .example-main h2 {
    margin: var(--space-3) 0 var(--space-6);
    color: var(--text-primary);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .example-columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .example-columns h3 {
    margin: 0 0 var(--space-3);
    color: var(--text-primary);
    font-size: 1rem;
  }

  .example-columns p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .example-action {
    margin-top: var(--space-6);
  }

  .result-card {
    min-height: 128px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    background: var(--bg-main);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .result-card strong {
    color: var(--brand-primary);
    font-size: 1.65rem;
    line-height: 1;
  }

  .result-card span {
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .note-panel,
  .cta-panel {
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    padding: var(--space-12);
  }

  .note-panel {
    max-width: 920px;
  }

  .note-panel h2,
  .cta-panel h2 {
    margin: 0 0 var(--space-4);
    color: var(--text-primary);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .note-panel p {
    color: var(--text-secondary);
    line-height: 1.75;
    font-size: 1.05rem;
  }

  .cta-panel {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-8);
    align-items: center;
    background:
      linear-gradient(135deg, rgba(42, 71, 54, 0.14), transparent 50%),
      var(--bg-surface);
  }

  .cta-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 1000px) {
    .example-card,
    .cta-panel {
      grid-template-columns: 1fr;
    }

    .results-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 700px) {
    .example-columns,
    .results-grid {
      grid-template-columns: 1fr;
    }

    .example-card,
    .note-panel,
    .cta-panel {
      padding: var(--space-6);
    }
  }
</style>
