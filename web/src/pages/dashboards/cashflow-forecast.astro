---
/**
 * cashflow-forecast.astro — Portfolio dashboard #3
 * Fictional facilities-maintenance company ("Solmark Facilities Group").
 * 13-week cash view: actuals solid, projection dashed with a widening
 * variance band, a "today" divider, and a minimum-reserve floor line that
 * a projected one-time expense nearly breaches. Maps to Cashflow Forecast
 * Agent — the classic CFO value prop: see the crunch before it happens.
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import JsonLd from '../../components/JsonLd.astro';
import data from '../../data/cashflowForecastData.json';
import { scaleSeries, linePath, gridYs, usd, usdK, CHART_W, CHART_H, CHART_PAD } from '../../lib/chartSvg';

const { meta, history } = data;
const N = history.length;
const todayIdx = meta.actualWeeks - 1;
const lowPoint = history[meta.lowPointIdx];
const endBalance = history[N - 1];
const startBalance = meta.startBalance;

const balanceVals = history.map((h) => h.balance);
const lowVals = history.map((h) => h.balanceLow);
const highVals = history.map((h) => h.balanceHigh);
const allVals = [...balanceVals, ...lowVals, ...highVals, meta.minReserve];
const scale = scaleSeries(allVals.concat([0]), Math.min(0, ...allVals) - 3000, Math.max(...allVals) * 1.06);

const actualVals = balanceVals.slice(0, meta.actualWeeks);
const actualScale = { x: scale.x, y: scale.y };
const projectedVals = balanceVals.slice(meta.actualWeeks - 1);
const projectedIdxOffset = meta.actualWeeks - 1;

const bandTop = highVals.slice(meta.actualWeeks - 1);
const bandBottom = lowVals.slice(meta.actualWeeks - 1);
const bandPath =
  bandTop.map((v, i) => (i === 0 ? 'M' : 'L') + scale.x(i + projectedIdxOffset).toFixed(1) + ',' + scale.y(v).toFixed(1)).join(' ') +
  ' L' + scale.x(bandBottom.length - 1 + projectedIdxOffset).toFixed(1) + ',' + scale.y(bandBottom[bandBottom.length - 1]).toFixed(1) + ' ' +
  bandBottom.slice().reverse().map((v, i) => 'L' + scale.x(bandBottom.length - 1 - i + projectedIdxOffset).toFixed(1) + ',' + scale.y(v).toFixed(1)).join(' ') +
  ' Z';

const flowMax = Math.max(...history.map((h) => Math.max(h.inflow, h.outflow)));
const flowScaleMax = flowMax * 1.15;
const barAreaH = 120;
const barW = (CHART_W - CHART_PAD.l - CHART_PAD.r) / N - 6;

const dipUnderTarget = lowPoint.balance < meta.minReserve + 12000;

const title = '13-Week Cashflow Forecast — Live Demo | 5 Cypress Data Analytics';
const description =
  'Interactive 13-week cashflow forecast dashboard for a fictional facilities-maintenance company: actuals, projection with variance band, and a minimum-reserve alert.';
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <JsonLd schema={{
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: '13-Week Cashflow Forecast Demo',
      description,
      creator: { '@type': 'Organization', name: '5 Cypress Data Analytics', url: 'https://www.5cypress.com' },
    }} />
  </Fragment>

  <section class="demo-hero section">
    <div class="container">
      <div class="demo-hero-top reveal">
        <div>
          <p class="lead-in">Live demo — synthetic data</p>
          <h1>{meta.companyName}</h1>
          <p class="demo-hero-sub">
            A fictional {meta.sector}. {meta.actualWeeks} weeks of actuals, {N - meta.actualWeeks} weeks
            projected — with a variance band that widens the further out it looks. This is what the
            Cashflow Forecast Agent surfaces before a tight week becomes a surprise.
          </p>
        </div>
        <div class="demo-hero-meta">
          <span class="demo-badge">Demo data</span>
          <span class="demo-period">13-week rolling window</span>
          <Button variant="primary" size="lg" magnetic ripple data-open-booking>Book a fit call</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section board-section">
    <div class="container">
      <div class="board-top reveal">
        <div class="exec-tiles">
          <div class="kpi-tile">
            <span class="kpi-label">Current cash balance</span>
            <strong class="kpi-value">{usdK(history[todayIdx].balance)}</strong>
            <span class="kpi-delta">as of this week</span>
          </div>
          <div class="kpi-tile">
            <span class="kpi-label">13-week low point</span>
            <strong class="kpi-value">{usdK(lowPoint.balance)}</strong>
            <span class={dipUnderTarget ? 'kpi-delta is-down' : 'kpi-delta is-up'}>{lowPoint.label}</span>
          </div>
          <div class="kpi-tile">
            <span class="kpi-label">Minimum reserve</span>
            <strong class="kpi-value">{usdK(meta.minReserve)}</strong>
            <span class="kpi-delta">floor, set by owner</span>
          </div>
          <div class="kpi-tile">
            <span class="kpi-label">Projected end balance</span>
            <strong class="kpi-value">{usdK(endBalance.balance)}</strong>
            <span class={endBalance.balance >= startBalance ? 'kpi-delta is-up' : 'kpi-delta is-down'}>vs {usdK(startBalance)} start</span>
          </div>
        </div>

        <aside class="alerts-panel" aria-label="Cashflow exceptions">
          <p class="panel-title">Needs a human</p>
          <div class="alert alert--warning">
            <span class="alert-icon" aria-hidden="true">▲</span>
            <div>
              <p class="alert-title">Balance dips to {usdK(lowPoint.balance)} in {lowPoint.label} <em class="alert-level">warning</em></p>
              <p class="alert-detail">
                An annual insurance renewal lands the same week as payroll. {usdK(lowPoint.balance - meta.minReserve)} above
                the reserve floor — tight, not breached. Worth timing the renewal a week earlier or later.
              </p>
            </div>
          </div>
          <div class="alert alert--info">
            <span class="alert-icon" aria-hidden="true">●</span>
            <div>
              <p class="alert-title">Two large contract payments assumed in weeks 8 and 11</p>
              <p class="alert-detail">Projection depends on those landing on schedule — that's most of the variance band width.</p>
            </div>
          </div>
        </aside>
      </div>

      <div class="chart-row reveal">
        <figure class="chart-card chart-card--full">
          <figcaption>
            <p class="chart-title">Cash balance — 13 weeks</p>
            <p class="chart-sub">Solid = actual. Dashed = projected, with a variance band. Dotted horizontal line is the minimum reserve.</p>
          </figcaption>
          <svg viewBox={'0 0 ' + CHART_W + ' ' + CHART_H} role="img" aria-label="13-week cash balance, actual and projected, against a minimum reserve line" class="line-chart">
            {gridYs().map((y) => <line x1={CHART_PAD.l} x2={CHART_W - CHART_PAD.r} y1={y} y2={y} class="grid-line" />)}

            <line x1={CHART_PAD.l} x2={CHART_W - CHART_PAD.r} y1={scale.y(meta.minReserve)} y2={scale.y(meta.minReserve)} class="reserve-line" />
            <text x={CHART_W - CHART_PAD.r} y={scale.y(meta.minReserve) - 6} class="axis-label reserve-label" text-anchor="end">min reserve {usdK(meta.minReserve)}</text>

            <line x1={scale.x(todayIdx)} x2={scale.x(todayIdx)} y1={CHART_PAD.t} y2={CHART_H - CHART_PAD.b} class="today-line" />
            <text x={scale.x(todayIdx) + 6} y={CHART_PAD.t + 10} class="axis-label today-label">today</text>

            <path d={bandPath} class="variance-band" />

            <path d={linePath(actualVals, actualScale)} fill="none" class="actual-line" />

            {projectedVals.map((v, i) => {
              if (i === 0) return null;
              const x1 = scale.x(i - 1 + projectedIdxOffset);
              const y1 = scale.y(projectedVals[i - 1]);
              const x2 = scale.x(i + projectedIdxOffset);
              const y2 = scale.y(v);
              return <line x1={x1} y1={y1} x2={x2} y2={y2} class="projected-seg" />;
            })}

            {history.map((h, i) => (
              <rect
                class="hit"
                x={scale.x(i) - 15} y={CHART_PAD.t} width="30" height={CHART_H - CHART_PAD.t - CHART_PAD.b}
                data-tip={h.label + ' — ' + usd(h.balance) + (h.isActual ? ' (actual)' : ' (projected)')}
                data-cx={scale.x(i)} data-cy={scale.y(h.balance)}
              />
            ))}
            <circle class="cursor-dot" r="4" fill="#199E70" stroke="#101014" stroke-width="2" style="display:none" />
          </svg>
        </figure>
      </div>

      <div class="chart-row reveal">
        <figure class="chart-card chart-card--full">
          <figcaption>
            <p class="chart-title">Weekly inflows vs outflows</p>
            <p class="chart-sub">Lumpy contract payments create the swings — payroll and rent are the steady drag.</p>
          </figcaption>
          <div class="flow-bars">
            {history.map((h, i) => {
              const inH = Math.round((h.inflow / flowScaleMax) * barAreaH);
              const outH = Math.round((h.outflow / flowScaleMax) * barAreaH);
              return (
                <div class="flow-col">
                  <div class="flow-bar-pair">
                    <div class="flow-bar flow-bar--in" style={'height:' + inH + 'px'} data-tip={h.label + ' — in ' + usd(h.inflow)}></div>
                    <div class="flow-bar flow-bar--out" style={'height:' + outH + 'px'} data-tip={h.label + ' — out ' + usd(h.outflow)}></div>
                  </div>
                  <span class="flow-label">{h.label.replace('Wk of ', '')}</span>
                </div>
              );
            })}
          </div>
          <div class="flow-legend">
            <span class="legend-item"><i class="swatch swatch--in"></i>Inflow</span>
            <span class="legend-item"><i class="swatch swatch--out"></i>Outflow</span>
          </div>
        </figure>
      </div>

      <p class="demo-disclaimer reveal">{meta.disclaimer} Seed #{meta.seed} · generated {meta.generatedAt}.</p>
    </div>
  </section>

  <section class="section demo-cta">
    <div class="container demo-cta-inner reveal">
      <p class="lead-in">See next quarter, not just last month</p>
      <h2>The tight week shows up 8 weeks early — not the week it happens.</h2>
      <p>
        Connected to your bank feed and QuickBooks. Every projection carries a variance band so
        you know how much to trust it, not just a single confident-looking number.
      </p>
      <Button variant="primary" size="lg" magnetic ripple data-open-booking>Book a fit call</Button>
    </div>
  </section>
</Layout>

<div class="chart-tooltip" id="chart-tooltip" role="status" aria-hidden="true"></div>

<script>
  const tip = document.getElementById('chart-tooltip')!;
  function showTip(text: string, x: number, y: number) {
    tip.textContent = text;
    tip.style.display = 'block';
    const r = tip.getBoundingClientRect();
    const left = Math.min(x + 14, window.innerWidth - r.width - 8);
    const top = y - r.height - 12;
    tip.style.left = left + 'px';
    tip.style.top = top + 'px';
  }
  function hideTip() { tip.style.display = 'none'; }
  document.querySelectorAll<HTMLElement>('[data-tip]').forEach((el) => {
    el.addEventListener('mousemove', (e) => {
      showTip(el.dataset.tip!, e.clientX, e.clientY);
      const svg = el.closest('svg');
      const dot = svg?.querySelector<SVGCircleElement>('.cursor-dot');
      if (dot && el.dataset.cx) {
        dot.setAttribute('cx', el.dataset.cx);
        dot.setAttribute('cy', el.dataset.cy!);
        dot.style.display = 'block';
      }
    });
    el.addEventListener('mouseleave', () => {
      hideTip();
      const dot = el.closest('svg')?.querySelector<SVGCircleElement>('.cursor-dot');
      if (dot) dot.style.display = 'none';
    });
  });
</script>

<style>
  .demo-hero {
    padding-top: calc(var(--space-24) + 3rem);
    padding-bottom: var(--space-8);
    background: linear-gradient(180deg, rgba(93,140,93,0.07), transparent 60%), var(--bg-main);
  }
  .demo-hero-top { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-10); flex-wrap: wrap; }
  .demo-hero h1 { font-size: clamp(2.6rem, 5vw, 4.4rem); margin-block: var(--space-3); }
  .demo-hero-sub { max-width: 62ch; color: var(--text-secondary); line-height: var(--leading-relaxed); }
  .demo-hero-meta { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-3); }
  .demo-badge {
    padding: var(--space-1) var(--space-3); border: 1px solid rgba(251,191,36,0.3); border-radius: var(--radius-full);
    background: rgba(251,191,36,0.08); color: var(--brand-accent); font-family: var(--font-mono);
    font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: var(--tracking-widest); text-transform: uppercase;
  }
  .demo-period { color: var(--text-disabled); font-family: var(--font-mono); font-size: var(--text-xs); }

  .board-section { padding-top: var(--space-8); }
  .board-top { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(300px, 0.8fr); gap: var(--space-5); margin-bottom: var(--space-5); align-items: start; }
  .exec-tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
  .kpi-tile { padding: var(--space-4); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: #101014; display: flex; flex-direction: column; gap: var(--space-2); }
  .kpi-label { color: var(--text-disabled); font-family: var(--font-mono); font-size: 0.64rem; font-weight: var(--weight-bold); letter-spacing: var(--tracking-wider); text-transform: uppercase; }
  .kpi-value { color: var(--text-primary); font-family: var(--font-heading); font-size: var(--text-3xl); font-weight: var(--weight-bold); line-height: 1; }
  .kpi-delta { color: var(--text-tertiary); font-family: var(--font-mono); font-size: var(--text-xs); }
  .kpi-delta.is-up { color: var(--success); }
  .kpi-delta.is-down { color: var(--warning); }

  .alerts-panel { border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: #101014; padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); }
  .panel-title { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: var(--tracking-widest); text-transform: uppercase; color: var(--text-disabled); }
  .alert { display: grid; grid-template-columns: 18px 1fr; gap: var(--space-2); padding: var(--space-3); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); background: rgba(20,20,24,0.7); }
  .alert--warning { border-color: rgba(245,158,11,0.25); }
  .alert--info { border-color: var(--border-subtle); }
  .alert-icon { font-size: 0.7rem; line-height: 1.6; }
  .alert--warning .alert-icon { color: var(--warning); }
  .alert--info .alert-icon { color: var(--text-disabled); }
  .alert-title { color: var(--text-primary); font-size: var(--text-sm); font-weight: var(--weight-semibold); line-height: var(--leading-snug); }
  .alert-level { font-style: normal; font-family: var(--font-mono); font-size: 0.6rem; text-transform: uppercase; letter-spacing: var(--tracking-wider); color: var(--text-disabled); }
  .alert-detail { margin-top: var(--space-1); color: var(--text-tertiary); font-size: var(--text-xs); line-height: var(--leading-normal); }

  .chart-row { display: grid; grid-template-columns: 1fr; gap: var(--space-5); margin-bottom: var(--space-5); }
  .chart-card { border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: #101014; padding: var(--space-5); margin: 0; }
  .chart-title { color: var(--text-primary); font-family: var(--font-heading); font-size: var(--text-lg); font-weight: var(--weight-semibold); }
  .chart-sub { margin-top: 2px; margin-bottom: var(--space-4); color: var(--text-tertiary); font-size: var(--text-sm); }
  .line-chart { width: 100%; height: auto; display: block; }
  .grid-line { stroke: rgba(255,255,255,0.06); stroke-width: 1; }
  .reserve-line { stroke: rgba(239,68,68,0.4); stroke-width: 1.5; stroke-dasharray: 2 3; }
  .reserve-label { fill: var(--error); font-family: var(--font-mono); font-size: 9px; }
  .today-line { stroke: rgba(255,255,255,0.28); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .today-label { fill: var(--text-tertiary); font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.05em; }
  .variance-band { fill: rgba(93,140,93,0.14); stroke: none; }
  .actual-line { stroke: #199E70; stroke-width: 2.5; stroke-linejoin: round; }
  .projected-seg { stroke: #199E70; stroke-width: 2; stroke-dasharray: 5 4; }
  .axis-label { fill: var(--text-disabled); font-family: var(--font-mono); font-size: 10px; }
  .hit { fill: transparent; cursor: crosshair; }

  .flow-bars { display: flex; align-items: flex-end; gap: 2px; height: 140px; padding-top: var(--space-4); }
  .flow-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: var(--space-2); min-width: 0; }
  .flow-bar-pair { display: flex; align-items: flex-end; gap: 2px; height: 120px; }
  .flow-bar { width: 10px; border-radius: 3px 3px 0 0; cursor: crosshair; transition: filter var(--duration-fast); }
  .flow-bar--in { background: #199E70; }
  .flow-bar--out { background: #C98500; }
  .flow-bar:hover { filter: brightness(1.35); }
  .flow-label { color: var(--text-disabled); font-family: var(--font-mono); font-size: 0.58rem; white-space: nowrap; }
  .flow-legend { display: flex; gap: var(--space-5); margin-top: var(--space-4); justify-content: center; }
  .legend-item { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--text-tertiary); font-family: var(--font-mono); font-size: var(--text-xs); }
  .swatch { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
  .swatch--in { background: #199E70; }
  .swatch--out { background: #C98500; }

  .demo-disclaimer { color: var(--text-disabled); font-family: var(--font-mono); font-size: var(--text-xs); text-align: center; }

  .demo-cta { background: var(--bg-surface); border-top: 1px solid var(--border-subtle); }
  .demo-cta-inner { max-width: 720px; margin-inline: auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-5); }
  .demo-cta p { color: var(--text-secondary); line-height: var(--leading-relaxed); }

  @media (max-width: 1100px) {
    .board-top { grid-template-columns: 1fr; }
    .exec-tiles { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .flow-label { display: none; }
  }
</style>

<style is:global>
  .chart-tooltip {
    display: none; position: fixed; z-index: 1600; padding: 6px 10px; border: 1px solid rgba(255,255,255,0.14);
    border-radius: 8px; background: rgba(10,10,12,0.95); color: #FEFEFE; font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem; pointer-events: none; white-space: nowrap; box-shadow: 0 8px 24px rgba(0,0,0,0.5);
  }
</style>
