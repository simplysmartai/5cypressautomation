---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import JsonLd from '../components/JsonLd.astro';

const steps = [
  {
    number: '01',
    label: 'Scope',
    title: 'Find the decision you make blind',
    body: 'We identify the decision you keep making late, the metrics behind it, the data sources, and the refresh cadence you actually need.',
  },
  {
    number: '02',
    label: 'Model',
    title: 'Define the metrics and the data model',
    body: 'You get a clear plan: each metric and how it is defined, the data sources, the review points, and how the dashboard is delivered and refreshed.',
  },
  {
    number: '03',
    label: 'Build',
    title: 'Build it on read-only data',
    body: 'We connect read-only to QBO, your CRM, and other sources, model the numbers, and build the dashboard. Synthetic data first, live data once the logic checks out.',
  },
  {
    number: '04',
    label: 'Launch',
    title: 'Hand it off, fully documented',
    body: 'We validate every metric end to end, document how each number is defined and sourced, and leave you a dashboard you and your accountant can trust.',
  },
];

const timelines = [
  ['Practice KPI dashboard', '10 to 14 business days'],
  ['Monthly reporting package', '10 to 14 business days'],
  ['Cashflow forecast', '14 to 21 business days'],
  ['Business intelligence model', '14 to 21 business days'],
  ['Spreadsheet automation', '5 to 10 business days'],
];
---

<Layout
  title="How We Build Your Dashboards | 5 Cypress"
  description="The 5 Cypress process for scoping, modeling, building, and launching dashboards and forecasts you can trust — for accounting firms and small businesses."
>
  <Fragment slot="head">
    <JsonLd schema={{
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: 'How 5 Cypress Builds a Dashboard',
      description: 'The 4-step process for scoping, modeling, building, and handing off a documented dashboard or forecast you can trust.',
      step: steps.map((step, index) => ({
        '@type': 'HowToStep',
        position: index + 1,
        name: step.label,
        text: step.body,
      })),
    }} />
  </Fragment>

  <section class="process-hero section">
    <div class="container">
      <div class="process-hero-inner reveal">
        <p class="lead-in">Process</p>
        <h1>From idle data to a number you can trust.</h1>
        <p class="process-hero-sub">
          The goal is not a dashboard for its own sake. It is a modeled source of truth,
          with every metric defined and traceable, in front of the person who has to
          make the call.
        </p>
      </div>
    </div>
  </section>

  <section class="section steps-section">
    <div class="container">
      <div class="steps-grid">
        {steps.map((step) => (
          <article class="step-card reveal">
            <div class="step-top">
              <span>{step.number}</span>
              <p>{step.label}</p>
            </div>
            <h2>{step.title}</h2>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section proof-section">
    <div class="container">
      <div class="proof-grid">
        <div class="proof-copy reveal">
          <p class="lead-in">What You Get</p>
          <h2>A dashboard your team can trust after launch.</h2>
          <p>
            Every build includes the metric definitions, the data sources, the refresh
            schedule, and a plain-English note on how each number is calculated. So when
            a partner questions a figure, you can show exactly how it was built — whether
            it came from QuickBooks, a CRM, or a spreadsheet.
          </p>
        </div>

        <div class="timeline-card reveal">
          <h3>Typical Build Windows</h3>
          <div class="timeline-list">
            {timelines.map(([name, time]) => (
              <div class="timeline-row">
                <span>{name}</span>
                <strong>{time}</strong>
              </div>
            ))}
          </div>
          <p>Exact timing depends on access, approvals, and how clean the source data is.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section rules-section">
    <div class="container">
      <div class="rules-panel reveal">
        <div>
          <p class="lead-in">Operating Rules</p>
          <h2>No black box. No mystery numbers.</h2>
        </div>
        <ul>
          <li>Read-only data access by default.</li>
          <li>Every metric defined and traceable to its source.</li>
          <li>Human review on any AI-assisted insight.</li>
          <li>Documentation your team can actually use.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container">
      <div class="cta-panel reveal">
        <h2>Start with the number you keep rebuilding by hand.</h2>
        <Button variant="primary" size="lg" magnetic ripple data-open-booking>
          Book a fit call
        </Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .process-hero {
    padding: calc(var(--space-24) + 3rem) 0 var(--space-24);
    background:
      linear-gradient(135deg, rgba(42, 71, 54, 0.09), transparent 48%),
      linear-gradient(180deg, var(--bg-main), var(--bg-surface));
  }

  .process-hero-inner {
    max-width: 900px;
  }

  .process-hero h1 {
    margin: 0 0 var(--space-6);
    color: var(--text-primary);
    font-size: clamp(2.75rem, 5.2vw, 4.5rem);
    line-height: 0.94;
    letter-spacing: 0;
  }

  .process-hero-sub {
    max-width: 720px;
    color: var(--text-secondary);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.7;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .step-card {
    min-height: 350px;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }

  .step-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
    color: var(--brand-accent);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .step-top p {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
  }

  .step-card h2 {
    margin: 0 0 var(--space-4);
    color: var(--text-primary);
    font-size: 1.55rem;
    line-height: 1.15;
  }

  .step-card > p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
    gap: var(--space-12);
    align-items: start;
  }

  .proof-copy h2,
  .rules-panel h2,
  .cta-panel h2 {
    margin: 0 0 var(--space-4);
    color: var(--text-primary);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .proof-copy p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .timeline-card,
  .rules-panel,
  .cta-panel {
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    padding: var(--space-8);
  }

  .timeline-card h3 {
    margin: 0 0 var(--space-6);
    color: var(--text-primary);
    font-size: 1.4rem;
  }

  .timeline-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border-medium);
  }

  .timeline-row span {
    color: var(--text-secondary);
  }

  .timeline-row strong {
    color: var(--text-primary);
    white-space: nowrap;
  }

  .timeline-card > p {
    color: var(--text-tertiary);
    line-height: 1.6;
    margin: var(--space-6) 0 0;
  }

  .rules-panel {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .rules-panel ul {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.9;
  }

  .cta-panel {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-8);
    align-items: center;
    background:
      linear-gradient(135deg, rgba(42, 71, 54, 0.14), transparent 50%),
      var(--bg-surface);
  }

  .cta-panel h2 {
    margin-bottom: 0;
  }

  @media (max-width: 1000px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .proof-grid,
    .rules-panel,
    .cta-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }

    .timeline-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
