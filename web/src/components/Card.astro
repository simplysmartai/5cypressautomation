---
/**
 * Card.astro — Service/feature card
 * Props:
 *   icon        string  SVG path data or inline SVG string
 *   title       string
 *   description string
 *   href        string  optional — makes card a link
 *   tag         string  optional eyebrow label
 *   highlight   boolean optional gold accent glow
 */
interface Props {
  title: string;
  description: string;
  href?: string;
  tag?: string;
  highlight?: boolean;
  timeline?: string;
  price?: string;
}
const { title, description, href, tag, highlight = false, timeline, price } = Astro.props;
---

{href ? (
  <a href={href} class={`card${highlight ? ' card--highlight' : ''}`}>
    <div class="card-icon-slot">
      <slot name="icon" />
    </div>
    {tag && <p class="card-tag">{tag}</p>}
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    {(timeline || price) && (
      <div class="card-meta">
        {timeline && <span class="card-meta-item"><span class="card-meta-label">Live in</span>{timeline}</span>}
        {price && <span class="card-meta-item card-meta-item--price"><span class="card-meta-label">From</span>{price}</span>}
      </div>
    )}
    <span class="card-arrow" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M7 17L17 7M17 7H7M17 7v10"/>
      </svg>
    </span>
  </a>
) : (
  <div class={`card${highlight ? ' card--highlight' : ''}`}>
    <div class="card-icon-slot">
      <slot name="icon" />
    </div>
    {tag && <p class="card-tag">{tag}</p>}
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    {(timeline || price) && (
      <div class="card-meta">
        {timeline && <span class="card-meta-item"><span class="card-meta-label">Live in</span>{timeline}</span>}
        {price && <span class="card-meta-item card-meta-item--price"><span class="card-meta-label">From</span>{price}</span>}
      </div>
    )}
  </div>
)}

<style>
  .card {
    position: relative;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.025), transparent),
      var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(251,191,36,0.08), transparent 42%);
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out);
    pointer-events: none;
  }
  .card:hover {
    border-color: var(--border-brand);
    box-shadow: 0 24px 70px rgba(0,0,0,0.35);
    transform: translateY(-3px);
  }
  .card:hover::before {
    opacity: 1;
  }
  .card--highlight {
    border-color: rgba(251,191,36, 0.2);
    background: linear-gradient(135deg, var(--bg-surface) 0%, rgba(251,191,36,0.04) 100%);
  }
  .card--highlight:hover {
    border-color: rgba(251,191,36, 0.4);
    box-shadow: var(--shadow-glow-accent);
  }

  .card-icon-slot :global(svg) {
    width: 40px;
    height: 40px;
    color: var(--brand-primary);
    stroke: currentColor;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--brand-primary);
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    line-height: var(--leading-snug);
  }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .card-meta {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }
  .card-meta-item {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    background: rgba(10,10,12,0.5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .card-meta-item--price {
    color: var(--brand-accent);
    border-color: rgba(251,191,36,0.22);
  }
  .card-meta-label {
    font-weight: var(--weight-normal);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    font-size: 0.62rem;
    color: var(--text-disabled);
  }

  .card-arrow {
    align-self: flex-end;
    color: var(--text-disabled);
    transition: color var(--duration-fast), transform var(--duration-fast);
  }
  .card:hover .card-arrow {
    color: var(--brand-primary);
    transform: translate(3px, -3px);
  }
</style>
