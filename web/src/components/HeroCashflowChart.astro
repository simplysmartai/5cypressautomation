---
/**
 * HeroCashflowChart.astro — homepage hero visual.
 * A live, hero-sized rendition of the flagship 13-week cashflow forecast.
 * Reuses the same data + SVG helpers as /dashboards/cashflow-forecast/ so the
 * story (balance line, "today" split, variance band, reserve floor) matches.
 * Display-only here — the full interactive/tooltip version lives on the route.
 * Draw + fade choreography is pure CSS, gated by prefers-reduced-motion; the
 * KPI numbers tick up via the shared [data-count] convention.
 */
import data from '../data/cashflowForecastData.json';
import { scaleSeries, linePath, gridYs, usdK } from '../lib/chartSvg';

const { meta, history } = data;
const N = history.length;
const todayIdx = meta.actualWeeks - 1;
const lowPoint = history[meta.lowPointIdx];

const balanceVals = history.map((h) => h.balance);
const lowVals = history.map((h) => h.balanceLow);
const highVals = history.map((h) => h.balanceHigh);
const allVals = [...balanceVals, ...lowVals, ...highVals, meta.minReserve];
const scale = scaleSeries(allVals.concat([0]), Math.min(0, ...allVals) - 3000, Math.max(...allVals) * 1.06);

const actualVals = balanceVals.slice(0, meta.actualWeeks);
const projectedVals = balanceVals.slice(meta.actualWeeks - 1);
const projOffset = meta.actualWeeks - 1;

const bandTop = highVals.slice(meta.actualWeeks - 1);
const bandBottom = lowVals.slice(meta.actualWeeks - 1);
const bandPath =
  bandTop.map((v, i) => (i === 0 ? 'M' : 'L') + scale.x(i + projOffset).toFixed(1) + ',' + scale.y(v).toFixed(1)).join(' ') +
  ' ' +
  bandBottom.slice().reverse().map((v, i) => 'L' + scale.x(bandBottom.length - 1 - i + projOffset).toFixed(1) + ',' + scale.y(v).toFixed(1)).join(' ') +
  ' Z';

const projPath = projectedVals
  .map((v, i) => (i === 0 ? 'M' : 'L') + scale.x(i + projOffset).toFixed(1) + ',' + scale.y(v).toFixed(1))
  .join(' ');

const endX = scale.x(N - 1);
const endY = scale.y(balanceVals[N - 1]);

// KPI readouts (in whole $K, ticked up from 0 via [data-count]).
const kpis = [
  { label: 'Current cash', value: Math.round(history[todayIdx].balance / 1000), tone: '' },
  { label: '13-wk projected low', value: Math.round(lowPoint.balance / 1000), tone: 'warn' },
  { label: 'Reserve floor', value: Math.round(meta.minReserve / 1000), tone: '' },
];
---

<a class="hero-chart-card" href="/dashboards/cashflow-forecast/" aria-label="Explore the 13-week cashflow forecast dashboard">
  <div class="hero-chart-head">
    <div>
      <span class="hero-chart-kicker">13-week cashflow forecast</span>
      <p class="hero-chart-name">Will there be enough cash?</p>
    </div>
    <span class="hero-chart-badge">Live demo · synthetic data</span>
  </div>

  <div class="hero-kpis">
    {kpis.map((k) => (
      <div class={'hero-kpi' + (k.tone === 'warn' ? ' hero-kpi--warn' : '')}>
        <span class="hero-kpi-label">{k.label}</span>
        <strong class="hero-kpi-value" data-count={k.value} data-prefix="$" data-suffix="K">${k.value}K</strong>
      </div>
    ))}
  </div>

  <svg
    viewBox={'0 0 ' + 720 + ' ' + 220}
    class="hero-line-chart"
    role="img"
    aria-label="Cash balance across 13 weeks: six weeks of actuals, then a projection with a widening variance band, tracked against a minimum reserve line."
    preserveAspectRatio="none"
  >
    {gridYs().map((y) => <line x1="44" x2="706" y1={y} y2={y} class="hero-grid-line" />)}

    <path d={bandPath} class="hero-variance-band" />

    <line x1="44" x2="706" y1={scale.y(meta.minReserve)} y2={scale.y(meta.minReserve)} class="hero-reserve-line" />
    <text x="700" y={scale.y(meta.minReserve) - 5} class="hero-reserve-label" text-anchor="end">min reserve {usdK(meta.minReserve)}</text>

    <line x1={scale.x(todayIdx)} x2={scale.x(todayIdx)} y1="14" y2="194" class="hero-today-line" />
    <text x={scale.x(todayIdx) + 6} y="24" class="hero-today-label">today</text>

    <path d={linePath(actualVals, scale)} class="hero-actual-line" pathLength="1" />
    <path d={projPath} class="hero-projected-line" />
    <circle cx={endX} cy={endY} r="4" class="hero-end-dot" />
  </svg>

  <span class="hero-chart-foot">Explore this dashboard <span aria-hidden="true">→</span></span>
</a>

<style>
  .hero-chart-card {
    display: block;
    position: relative;
    padding: var(--space-6);
    border: 1px solid var(--border-medium);
    border-radius: 28px;
    background:
      linear-gradient(180deg, rgba(93,140,93,0.13), transparent 32%),
      radial-gradient(circle at 90% 0%, rgba(251,191,36,0.16), transparent 34%),
      #101014;
    box-shadow: 0 50px 120px rgba(0,0,0,0.62);
    overflow: hidden;
    transition: transform var(--duration-normal) var(--ease-out), box-shadow var(--duration-normal) var(--ease-out);
  }
  .hero-chart-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, black, transparent 78%);
    pointer-events: none;
  }
  .hero-chart-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 60px 130px rgba(0,0,0,0.66), var(--shadow-glow);
  }
  .hero-chart-card > * { position: relative; z-index: 1; }

  .hero-chart-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .hero-chart-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--brand-primary-light);
  }
  .hero-chart-name {
    margin-top: var(--space-2);
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
  }
  .hero-chart-badge {
    flex-shrink: 0;
    white-space: nowrap;
    padding: 6px 10px;
    border: 1px solid rgba(251,191,36,0.24);
    border-radius: var(--radius-full);
    background: rgba(251,191,36,0.08);
    color: var(--brand-accent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .hero-kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .hero-kpi {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-main);
  }
  .hero-kpi-label {
    display: block;
    color: var(--text-disabled);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }
  .hero-kpi-value {
    display: block;
    margin-top: var(--space-2);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .hero-kpi--warn .hero-kpi-value { color: var(--brand-accent); }

  .hero-line-chart {
    display: block;
    width: 100%;
    height: 180px;
  }
  .hero-grid-line { stroke: rgba(255,255,255,0.06); stroke-width: 1; }
  .hero-variance-band { fill: rgba(93,140,93,0.14); stroke: none; }
  .hero-reserve-line { stroke: rgba(239,68,68,0.4); stroke-width: 1.5; stroke-dasharray: 2 3; }
  .hero-reserve-label { fill: var(--error); font-family: var(--font-mono); font-size: 9px; }
  .hero-today-line { stroke: rgba(255,255,255,0.28); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .hero-today-label { fill: var(--text-tertiary); font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.05em; }
  .hero-actual-line { fill: none; stroke: #199E70; stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }
  .hero-projected-line { fill: none; stroke: #199E70; stroke-width: 2; stroke-dasharray: 5 4; }
  .hero-end-dot { fill: #199E70; stroke: #101014; stroke-width: 2; }

  .hero-chart-foot {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--brand-primary-light);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .hero-chart-card:hover .hero-chart-foot { color: var(--brand-accent); }

  /* ── Entrance choreography (motion only) ─────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    /* balance line draws itself, then band/reserve/today/projection fade in */
    .hero-actual-line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: heroDraw 1.15s var(--ease-out) 0.15s forwards;
    }
    .hero-projected-line,
    .hero-variance-band,
    .hero-reserve-line,
    .hero-reserve-label,
    .hero-today-line,
    .hero-today-label,
    .hero-end-dot {
      opacity: 0;
      animation: heroFade 0.6s var(--ease-out) 1.2s forwards;
    }
  }
  @keyframes heroDraw { to { stroke-dashoffset: 0; } }
  @keyframes heroFade { to { opacity: 1; } }

  @media (max-width: 520px) {
    .hero-chart-head { flex-direction: column; }
    .hero-kpi-value { font-size: var(--text-xl); }
    .hero-line-chart { height: 150px; }
  }
</style>
